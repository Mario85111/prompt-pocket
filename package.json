{
  "name": "prompt-pocket",
  "version": "0.1.0",
  "private": true,
  "description": "Prompt Pocket — tworzenie i katalogowanie promptów",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.node.json",
    "dev:renderer": "vite",
    "dev": "npm run build:main && concurrently -k -n vite,electron -c cyan,magenta \"vite\" \"wait-on tcp:5173 && cross-env NODE_ENV=development electron .\"",
    "build": "npm run build:main && vite build",
    "start": "npm run build && electron .",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "npm run build:main && node tests/run-all.js",
    "dist:linux": "npm run build && electron-builder --linux AppImage tar.gz --x64"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^4.6.5"
  },
  "build": {
    "appId": "pl.promptpocket.app",
    "productName": "Prompt Pocket",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json",
      "build/icon.png"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "PromptPocket-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "tar.gz"
      ],
      "category": "Utility",
      "artifactName": "PromptPocket-${version}-linux-${arch}.${ext}"
    }
  },
  "author": "Prompt Pocket"
}
